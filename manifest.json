{
  "manifest_version": 3,
  "name": "Web Pilot",
  "version": "1.1",
  "description": "Chat with any website.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "storage", "scripting", "tabs", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open WebPilot AI"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/webpilot-logo-black-white-theme-16.png",
    "48": "icons/webpilot-logo-black-white-theme-48.png",
    "128": "icons/webpilot-logo-black-white-theme-148.png"
  }
}
